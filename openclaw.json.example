{
  "agents": {
    "defaults": {
      "workspace": "${STAR_TIDE_ROOT}/workspace",
      "model": {
        "primary": "qwen3-6-27b-api-siliconflow-cn/Qwen/Qwen3.6-27B",
        "fallbacks": [
          "deepseek-api/deepseek-chat"
        ]
      },
      "models": {
        "qwen3-6-27b-api-siliconflow-cn/Qwen/Qwen3.6-27B": {
          "alias": "Qwen3.6"
        },
        "deepseek-api/deepseek-chat": {
          "alias": "DeepSeek"
        }
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "workspace": "${STAR_TIDE_ROOT}/agents/main",
        "subagents": {
          "allowAgents": [
            "github-trending",
            "opensource-analyzer",
            "ppt-maker"
          ]
        },
        "tools": {
          "alsoAllow": ["lobster", "sessions_spawn", "sessions_yield"]
        }
      },
      {
        "id": "github-trending",
        "workspace": "${STAR_TIDE_ROOT}/agents/github-trending"
      },
      {
        "id": "opensource-analyzer",
        "workspace": "${STAR_TIDE_ROOT}/agents/opensource-analyzer"
      },
      {
        "id": "ppt-maker",
        "workspace": "${STAR_TIDE_ROOT}/agents/ppt-maker"
      }
    ]
  },
  "plugins": {
    "allow": [
      "lobster",
      "openclaw-weixin",
      "qqbot"
    ],
    "entries": {
      "lobster": { "enabled": true },
      "openclaw-weixin": { "enabled": false },
      "qqbot": { "enabled": false }
    }
  },
  "channels": {
    "openclaw-weixin": {
      "enabled": true,
      "dmPolicy": "pairing"
    },
    "qqbot": {
      "enabled": false,
      "groupPolicy": "allowlist"
    }
  },
  "bindings": [
    {
      "agentId": "main",
      "match": { "channel": "openclaw-weixin" }
    },
    {
      "agentId": "main",
      "match": { "channel": "qqbot" }
    }
  ],
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": true
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "full"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "qwen3-6-27b-api-siliconflow-cn": {
        "baseUrl": "https://api.siliconflow.cn/v1",
        "api": "openai-completions",
        "apiKey": "${SILICONFLOW_API_KEY}",
        "timeoutSeconds": 600,
        "models": [
          {
            "id": "Qwen/Qwen3.6-27B",
            "name": "Qwen/Qwen3.6-27B (Custom Provider)",
            "contextWindow": 128000,
            "maxTokens": 4096,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "reasoning": false
          }
        ]
      },
      "deepseek-api": {
        "baseUrl": "https://api.deepseek.com/v1",
        "api": "openai-completions",
        "apiKey": "${DEEPSEEK_API_KEY}",
        "timeoutSeconds": 600,
        "models": [
          {
            "id": "deepseek-chat",
            "name": "DeepSeek Chat (Fallback)",
            "contextWindow": 64000,
            "maxTokens": 4096,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "reasoning": false
          }
        ]
      }
    }
  }
}
