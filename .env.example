# 复制到 ~/.openclaw/.env 并填入真实值（勿提交 Git）
# OpenClaw 启动时会加载该文件，并替换 star-tide-daily.json 中的 ${VAR_NAME}

# 本仓库在 ECS/本机的绝对路径（须与实际 git clone 路径一致）
STAR_TIDE_ROOT=/绝对路径/star-tide-daily

SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
OPENCLAW_GATEWAY_TOKEN=your-gateway-token
